From faaa447c77023eb057610534934f0db486aa79dc Mon Sep 17 00:00:00 2001
From: Usama Masood <usama.masood.mirza@gmail.com>
Date: Sat, 19 Sep 2026 19:10:44 +0500
Subject: [PATCH] Allow passing an environment to the headless server

KiCadServer starts kicad-cli with the environment of the current
process. A caller that wants the server to use a private settings
directory (KICAD_CONFIG_HOME) or a different TEMP for the socket has to
change os.environ before constructing KiCad(headless=True), which leaks
into everything else the process runs, or replace KiCadServer.

Add an optional env mapping to KiCadServer and KiCad() that is handed
to Popen unchanged. The default still inherits the environment.
---
 kipy/kicad.py  |  8 ++++++--
 kipy/server.py | 11 +++++++++++
 2 files changed, 17 insertions(+), 2 deletions(-)

diff --git a/kipy/kicad.py b/kipy/kicad.py
index 9bc266d..287f876 100644
--- a/kipy/kicad.py
+++ b/kipy/kicad.py
@@ -28,7 +28,7 @@ import random
 import string
 import sys
 import time
-from collections.abc import Sequence
+from collections.abc import Mapping, Sequence
 from tempfile import gettempdir
 from typing import cast
 
@@ -172,6 +172,7 @@ class KiCad:
         headless: bool = False,
         kicad_cli_path: str | None = None,
         file_path: str | None = None,
+        env: Mapping[str, str] | None = None,
     ):
         """Creates a connection to a running KiCad instance
 
@@ -187,6 +188,9 @@ class KiCad:
         :param headless: Start and connect to a headless ``kicad-cli api-server`` instance.
         :param kicad_cli_path: Optional path to ``kicad-cli``.
         :param file_path: Optional path to a board, schematic, or project file to pre-load in headless mode.
+        :param env: Optional environment for the headless ``kicad-cli`` process, for example
+            with ``KICAD_CONFIG_HOME`` pointing at a private settings directory.  Leave default
+            to inherit the current environment.
         """
         self._server: KiCadServer | None = None
 
@@ -195,7 +199,7 @@ class KiCad:
                 raise ValueError("socket_path cannot be used when headless=True")
 
             cli_path = find_kicad_cli(kicad_cli_path)
-            server = KiCadServer(cli_path, file_path=file_path)
+            server = KiCadServer(cli_path, file_path=file_path, env=env)
             server.start()
             server.wait_for_ready(timeout_s=max(float(timeout_ms) / 1000.0, 5.0))
             self._server = server
diff --git a/kipy/server.py b/kipy/server.py
index dd11ee6..ec1195c 100644
--- a/kipy/server.py
+++ b/kipy/server.py
@@ -32,6 +32,7 @@ import tempfile
 import threading
 import time
 import uuid
+from collections.abc import Mapping
 from pathlib import Path
 from typing import IO
 
@@ -135,10 +136,19 @@ class KiCadServer:
         kicad_cli_path: str,
         file_path: str | None = None,
         socket_path: str | None = None,
+        env: Mapping[str, str] | None = None,
     ):
+        """
+        :param kicad_cli_path: Path to the ``kicad-cli`` executable.
+        :param file_path: Optional board, schematic or project file to pre-load.
+        :param socket_path: Optional socket path for the server to listen on.
+        :param env: Optional environment for the server process (for example a private
+            ``KICAD_CONFIG_HOME``).  Leave default to inherit the current environment.
+        """
         self._kicad_cli_path = kicad_cli_path
         self._file_path = file_path
         self._socket_path = socket_path or self._generate_socket_path()
+        self._env = dict(env) if env is not None else None
 
         self._process: subprocess.Popen[str] | None = None
         self._stdout_lines: queue.Queue[str] = queue.Queue()
@@ -177,6 +187,7 @@ class KiCadServer:
             stderr=subprocess.PIPE,
             text=True,
             bufsize=1,
+            env=self._env,
         )
 
         self._stdout_thread = threading.Thread(
