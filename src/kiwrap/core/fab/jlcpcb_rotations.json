{
  "_source": "Rotation corrections for JLCPCB SMT assembly, keyed by KiCad footprint name (the pos file's Package column). Values from matthewlai/JLCKicadTools jlc_kicad_tools/cpl_rotations_db.csv (MIT; fetched 2026-09-20), the table Bouni/kicad-jlcpcb-tools (MIT) downloads as its default 'Footprint pattern,Rotation,Offset X,Offset Y' corrections; entries for the KiCad library names of the most common packages added where the upstream regexes are looser. Rotation is added AFTER the bottom-side mirroring (kiwrap.core.fab.position); offsets are millimetres in the footprint frame. Longest regex match wins. Edit or extend per project by passing rotations=[...] to kw_fab_export; no correction is ever silent - kw_fab_export reports every corrected row.",
  "_note": "JLCPCB corrects many common parts on their side since 2023 and shows a preview of every part's orientation in the order review; ALWAYS check that preview. A wrong entry here costs a whole assembly run.",
  "rules": [
    {"pattern": "^R_Array_Convex_", "rotation": 90},
    {"pattern": "^R_Array_Concave_", "rotation": 90},
    {"pattern": "^SOT-223", "rotation": 180},
    {"pattern": "^SOT-23", "rotation": -90},
    {"pattern": "^SOT-89", "rotation": 180},
    {"pattern": "^TSOT-23", "rotation": 180},
    {"pattern": "^SOT-353", "rotation": 180},
    {"pattern": "^SOT-363", "rotation": 180},
    {"pattern": "^SOT-143", "rotation": 180},
    {"pattern": "^SC-74-6", "rotation": 180},
    {"pattern": "^LQFP-", "rotation": 270},
    {"pattern": "^TQFP-", "rotation": 270},
    {"pattern": "^SOP-4_", "rotation": 0},
    {"pattern": "^SOP-(?!18_)", "rotation": 270},
    {"pattern": "^SOP-18_", "rotation": 0},
    {"pattern": "^TSSOP-", "rotation": 270},
    {"pattern": "^SSOP-", "rotation": 270},
    {"pattern": "^HTSSOP-", "rotation": 270},
    {"pattern": "^DFN-", "rotation": 270},
    {"pattern": "^SOIC-", "rotation": 270},
    {"pattern": "^SO-14", "rotation": -90},
    {"pattern": "^SOIC127P798X216-8N", "rotation": -90},
    {"pattern": "^VSSOP-8_3.0x3.0mm_P0.65mm", "rotation": 270},
    {"pattern": "^VSSOP-8_", "rotation": 180},
    {"pattern": "^VSSOP-10_", "rotation": 270},
    {"pattern": "^VSON-8_", "rotation": 270},
    {"pattern": "^TSOP-6", "rotation": 270},
    {"pattern": "^UDFN-10", "rotation": 270},
    {"pattern": "^USON-10", "rotation": 270},
    {"pattern": "^TDSON-8-1", "rotation": 270},
    {"pattern": "^WSON-8-1EP_6x5mm_P1.27mm", "rotation": -90},
    {"pattern": "^PowerPAK_SO-8_Single", "rotation": 270},
    {"pattern": "^HTSSOP-28-1EP_4.4x9.7mm", "rotation": 270},
    {"pattern": "^(.*?_|V)?QFN-(16|20|24|28|40)(-|_|$)", "rotation": 270},
    {"pattern": "^Bosch_LGA-8_2x2.5mm_P0.65mm_ClockwisePinNumbering", "rotation": 90},
    {"pattern": "^CP_EIA-", "rotation": 180},
    {"pattern": "^CP_Elec_8x5.4", "rotation": 180},
    {"pattern": "^CP_Elec_8x10.5", "rotation": 180},
    {"pattern": "^CP_Elec_6.3x7.7", "rotation": 180},
    {"pattern": "^CP_Elec_8x6.7", "rotation": 180},
    {"pattern": "^CP_Elec_8x10", "rotation": 180},
    {"pattern": "^CP_Elec_10x10", "rotation": 180},
    {"pattern": "^PUIAudio_SMT_0825_S_4_R", "rotation": 270},
    {"pattern": "^USB_C_Receptacle_HRO_TYPE-C-31-M-12", "rotation": 180},
    {"pattern": "^USB_C_Receptacle_XKB_U262-16XN-4BVC11", "rotation": 0, "offset_mm": [1.44, 0]},
    {"pattern": "^ESP32-W", "rotation": 270},
    {"pattern": "^RP2040-QFN-56", "rotation": 270},
    {"pattern": "^SW_DIP_SPSTx01_Slide_Copal_CHS-01B_W7.62mm_P1.27mm", "rotation": -180},
    {"pattern": "^BatteryHolder_Keystone_1060_1x2032", "rotation": -180},
    {"pattern": "^Relay_DPDT_Omron_G6K-2F-Y", "rotation": 270},
    {"pattern": "^TO-277", "rotation": 90},
    {"pattern": "^SW_SPST_B3", "rotation": 90},
    {"pattern": "^Transformer_Ethernet_Pulse_HX0068ANL", "rotation": 270},
    {"pattern": "^JST_GH_SM", "rotation": 180},
    {"pattern": "^JST_PH_S", "rotation": 180},
    {"pattern": "^Diodes_PowerDI3333-8", "rotation": 270},
    {"pattern": "^Quectel_L80-R", "rotation": 270},
    {"pattern": "^PinHeader_2x05_P1\\.27mm_Vertical", "rotation": 90, "offset_mm": [2.54, 0.635]},
    {"pattern": "^LED_WS2812B-2020_PLCC4_2.0x2.0mm", "rotation": 90}
  ]
